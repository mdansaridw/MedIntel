# Application Config
FLASK_ENV=development
PORT=5000
SECRET_KEY=domain-expansion

# Neo4j Aura Cloud DB Configuration
NEO4J_URI=neo4j+ssc://your-aura-instance.databases.neo4j.io
NEO4J_USERNAME=your-username
NEO4J_PASSWORD=your-aura-password
NEO4J_DATABASE=neo4j
AURA_INSTANCEID=your-instance-id
AURA_INSTANCENAME=MedIntel

# Security & PII Vault
VAULT_ENCRYPTION_KEY=32_byte_base64_encryption_key_here

# LLM & Clinical Extraction (Gemini / Claude / OpenAI)
GEMINI_API_KEY=your-gemini-api-key
